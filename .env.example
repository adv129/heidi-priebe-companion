# Secrets only — never put these in config.json.
# The default provider (claude-p) needs NO key: it uses your local Claude Code login.

# Only required if you set provider = "openrouter" in config.json:
# OPENROUTER_API_KEY=sk-or-...

# Only required if you set provider = "anthropic" in config.json (direct Anthropic
# API, per-token billing — picks a model per call kind, see config.anthropic.models):
# ANTHROPIC_API_KEY=sk-ant-...
